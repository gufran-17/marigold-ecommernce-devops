# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (use the service name, e.g. mongodb://mongo:27017/ecommerce, when running in containers)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Auth (generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=0ab78859ce56737cb8f30005e519dc5e87fefc1255c2c2f198fd7c3b4377ad3368f25ebe5b67f452967ac1ce3d608587
JWT_EXPIRES_IN=1d

# CORS: frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Images
UPLOAD_DIR=uploads
PUBLIC_URL=

# Shipping
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999

# Seed (dev defaults are used if empty; REQUIRED when NODE_ENV=production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Gufran@2003
